# Environment Configuration
NODE_ENV=development

# Browser Configuration
BROWSER=chrome
HEADLESS=false
WINDOW_SIZE=1920,1080

# Platform Configuration  
PLATFORM=linux

# Test Configuration
BASE_URL=https://the-internet.herokuapp.com
ENVIRONMENT=dev
RETRY_COUNT=3
TIMEOUT=30000
IMPLICIT_WAIT=10000
EXPLICIT_WAIT=30000

# Parallel Execution
PARALLEL_MODE=true
MAX_WORKERS=4

# Reporting
ENABLE_SCREENSHOTS=true
ENABLE_VIDEO=false
ENABLE_LOGGING=true
LOG_LEVEL=info

# Dashboard Configuration
DASHBOARD_PORT=3001
API_PORT=3000

# Optional Integrations
SLACK_WEBHOOK_URL=
EMAIL_NOTIFICATIONS=false

# CI/CD Configuration
CI_MODE=false
GITHUB_TOKEN=