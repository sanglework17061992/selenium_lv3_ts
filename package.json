{
  "name": "selenium-typescript-framework",
  "version": "1.0.0",
  "description": "Selenium TypeScript Automation Framework with Dashboard",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:parallel": "jest --maxWorkers=4",
    "test:headless": "cross-env HEADLESS=true jest",
    "test:chrome": "cross-env BROWSER=chrome jest",
    "test:firefox": "cross-env BROWSER=firefox jest",
    "test:edge": "cross-env BROWSER=edge jest",
    "test:safari": "cross-env BROWSER=safari jest",
    "test:report": "jest && allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "dashboard:dev": "concurrently \"npm run dashboard:backend\" \"npm run dashboard:frontend\"",
    "dashboard:backend": "cd dashboard/backend && npm run dev",
    "dashboard:frontend": "cd dashboard/frontend && npm start",
    "dashboard:build": "cd dashboard/frontend && npm run build",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "rimraf dist reports/allure-results reports/allure-report node_modules/.cache"
  },
  "keywords": [
    "selenium",
    "typescript",
    "automation",
    "testing",
    "framework",
    "dashboard",
    "cross-browser",
    "parallel-testing"
  ],
  "author": "Automation Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.8.10",
    "@types/selenium-webdriver": "^4.35.3",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "allure-jest": "^2.15.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "selenium-webdriver": "^4.15.0",
    "winston": "^3.11.0"
  }
}
